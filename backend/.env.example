PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
PROJECT_ID=demo-client
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_CALLBACK_URL=http://localhost:5173/auth/callback
# Set up a GitHub OAuth App whose callback is https://API_HOST/v1/auth/github/callback.
# Keep the secret on the API host. OAuth and sync stay disabled until configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# JSON object from numeric GitHub account ID to role for this one project.
ACCESS_MAP_JSON={}
# Optional approved Issue comment sync. Requires repository scope and a fine-grained token.
GITHUB_REPOSITORY=
GITHUB_TOKEN=
STORAGE_DIR=./private-uploads
MAX_UPLOAD_BYTES=5000000
SESSION_TTL_SECONDS=3600
LOG_LEVEL=info

# Required to expose /metrics. Use a unique secret and restrict ingress to your monitoring network.
METRICS_BEARER_TOKEN=
